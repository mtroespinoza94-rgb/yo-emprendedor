rules_version = '2';

// Reglas de seguridad de "Yo Emprendedor"
// Estructura: cada usuario es su propia carpeta (usuarios/{uid}) con
// sub-carpetas privadas adentro. Nadie lee ni escribe fuera de su propio uid,
// salvo su propio perfil público mínimo (para validar códigos de referido).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Perfil del usuario y todo lo que cuelga de él ----
    match /usuarios/{uid} {

      // Solo el dueño puede leer su propio perfil.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Solo se puede CREAR el perfil una vez, al primer inicio de sesión,
      // y siempre con los valores iniciales correctos — nadie puede
      // registrarse ya con plan pagado o con días de cortesía regalados.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.plan == 'gratis'
        && request.resource.data.diasSinAnunciosHasta == null
        && request.resource.data.rachaActividad == 0;

      // IMPORTANTE: antes había además una regla "allow write" sin
      // restricciones sobre esta misma ruta. En Firestore las reglas se
      // combinan con "o" — si UNA regla permite la acción, se permite,
      // sin importar qué tan estrictas sean las demás. Esa regla amplia
      // dejaba pasar cualquier actualización (incluyendo cambiar el propio
      // "plan" a "pago" gratis) y volvía inútil esta protección de abajo.
      // Por eso aquí solo queda "allow update" — nunca junto con un
      // "allow write" o "allow read, write" general en esta misma ruta.
      //
      // En una actualización, el dueño solo puede tocar su "perfil"
      // (nombre, celular, foto). Todo lo demás — plan, código de
      // referido, quién lo invitó, racha de actividad, días sin
      // anuncios — solo lo puede cambiar una Cloud Function con
      // credenciales de administrador (que no pasa por estas reglas),
      // nunca el propio celular del usuario.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.codigoReferido == resource.data.codigoReferido
        && request.resource.data.referidoPor == resource.data.referidoPor
        && request.resource.data.diasSinAnunciosHasta == resource.data.diasSinAnunciosHasta
        && request.resource.data.rachaActividad == resource.data.rachaActividad;

      // Para el botón de "eliminar mi cuenta y mis datos" (fase 4).
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Todo lo que vive dentro de la carpeta del usuario (clientes,
      // ventas, abonos, etc.) hereda la misma regla: solo el dueño entra.
      match /{coleccion}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---- Config global: nadie desde la app, solo tú desde la consola ----
    match /sistema/{doc} {
      allow read, write: if false;
    }

    // Cualquier otra ruta no contemplada: cerrada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
